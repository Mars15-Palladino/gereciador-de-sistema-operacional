{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Construir gerenciador",
            "command": "C:\\msys64\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\main.c",
                "${workspaceFolder}\\processos\\processos.c",
                "${workspaceFolder}\\escalonador\\escalonador.c",
                "${workspaceFolder}\\memoria\\memoria.c",
                "${workspaceFolder}\\relogio\\relogio.c",
                "${workspaceFolder}\\io\\io.c",
                "${workspaceFolder}\\arquivos\\arquivos.c",
                "${workspaceFolder}\\recursos\\recursos.c",
                "${workspaceFolder}\\semaforos\\semaforos.c",
                "${workspaceFolder}\\logs\\logs.c",
                "${workspaceFolder}\\estatistica\\estatistica.c",
                "-o",
                "${workspaceFolder}\\gerenciador.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila o programa principal e o módulo de processos."
        }
    ],
    "version": "2.0.0"
}